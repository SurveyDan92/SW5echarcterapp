  const fileInputRef = useRef(null);
  
  const [character, setCharacter] = useState({
    // Basic Info
    name: '',
    species: '',
    class: '',
    background: '',
    level: 1,
    
    // Ability Scores
    abilities: {
      strength: 10,
      dexterity: 10,
      constitution: 10,
      intelligence: 10,
      wisdom: 10,
      charisma: 10
    },
    
    // Combat Stats
    hitPoints: 0,
    maxHitPoints: 0,
    tempHitPoints: 0,
    armorClass: 10,
    proficiencyBonus: 2,
    speed: 30,
    
    // Applied Bonuses (from species/class)
    appliedAbilityBonuses: {},
    availableSkillChoices: [],
    selectedClassSkills: [],
    
    // Skills & Proficiencies
    skillProficiencies: {},
    skillExpertise: {},
    savingThrowProficiencies: {},
    languages: [],
    toolProficiencies: [],
    weaponProficiencies: [],
    armorProficiencies: [],
    
    // Force & Tech
    forcePowerLevel: 0,
    forcePoints: 0,
    techPowerLevel: 0,
    techPoints: 0,
    
    // Equipment
    credits: 0,
    equipment: [],
    weapons: [],
    armor: null,
    
    // Story Elements
    personality: '',
    ideals: '',
    bonds: '',
    flaws: '',
    backstory: '',
    
    // Campaign Preferences
    preferredEra: '',
    preferredTone: '',
    preferredComplexity: 'standard'
  });

  // SW5e Species with mechanical data
  const speciesData = {
    'Human': {
      abilityIncrease: { any: 1, choice: 1 }, // +1 to any ability, +1 to another
      size: 'Medium',
      speed: 30,
      languages: ['Galactic Basic'],
      features: ['Extra Language', 'Extra Skill'],
      darkvision: 0
    },
    'Chiss': {
      abilityIncrease: { intelligence: 2, wisdom: 1 },
      size: 'Medium', 
      speed: 30,
      languages: ['Galactic Basic', 'Cheunh'],
      features: ['Darkvision', 'Chiss Tactics'],
      darkvision: 60
    },
    'Twi\'lek': {
      abilityIncrease: { charisma: 2, dexterity: 1 },
      size: 'Medium',
      speed: 30, 
      languages: ['Galactic Basic', 'Twi\'leki'],
      features: ['Darkvision', 'Natural Dancers'],
      darkvision: 60
    },
    'Wookiee': {
      abilityIncrease: { strength: 2, constitution: 1 },
