    },
    'Zabrak': {
      abilityIncrease: { constitution: 2, charisma: 1 },
      size: 'Medium',
      speed: 30,
      languages: ['Galactic Basic', 'Zabraki'],
      features: ['Darkvision', 'Aggressive'],
